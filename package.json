{
  "name": "@revealui-studio/revmind",
  "version": "0.1.0",
  "description": "RevMind — architecture from your knowledge graph. Fleet product. Not a public Architecture SKU.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/revealui-studio/revmind.git"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@revealui/presentation": "^0.13.1",
    "@revealui/router": "^0.3.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "29.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist",
    "dev": "vite dev --port 3002",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "preview": "vite preview --port 3002",
    "start": "vite preview --port 3002",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --coverage.reporter=json-summary --coverage.reporter=html --coverage.reporter=text",
    "typecheck": "tsc --noEmit"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": ">=2.0.5",
      "hono": "4.13.13",
      "postcss": "8.5.25",
      "undici": ">=7.29.0 <8",
      "vite": "8.2.0",
      "typescript": "7.0.2"
    }
  },
  "packageManager": "pnpm@10.28.2"
}
